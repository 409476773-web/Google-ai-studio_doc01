{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@rain-next/foundations": [
        "./src/rain/foundations/index.ts"
      ],
      "@rain-next/foundations/*": [
        "./src/rain/foundations/*"
      ],
      "@rain-next/layouts": [
        "./src/rain/layouts/index.ts"
      ],
      "@rain-next/layouts/*": [
        "./src/rain/layouts/*"
      ],
      "@rain-next/ui": [
        "./src/rain/ui/index.ts"
      ],
      "@rain-next/ui/*": [
        "./src/rain/ui/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["dist"]
}
